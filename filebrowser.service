[Unit]
Description=File Browser (files service on <your-domain>/files)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=anaya
WorkingDirectory=<your-project-path>/ragkg/fb
ExecStart=/usr/local/bin/filebrowser --address 127.0.0.1 --port 8124 --root <your-project-path>/ragkg/files --baseURL /files
Restart=on-failure
RestartSec=5
# filebrowser 默认写配置到 WorkingDirectory
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target